{
 "schema": 1,
 "id": "photometry",
 "name": "Photometry",
 "tab": "Measure",
 "order": 20,
 "description": "PSF, multi-band and crowded-field photometry, cross-match, segmentation map, completeness.",
 "steps": [
  {
   "id": "psf_phot",
   "label": "PSF Photometry",
   "legacy": [
    "Analysis > PSF Photometry"
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.psf_phot"
   ],
   "needs": [
    "catalog",
    "image",
    "psf"
   ],
   "title": "PSF photometry",
   "record": "analysis.psf_phot",
   "requires": "psf",
   "done_status": "PSF photometry complete",
   "catalog_tmp": "psfphot",
   "cli": [
    "{python}",
    "{script:ds9_psf_phot.py}",
    "{image}",
    "--catalog",
    "{catalog}",
    "--psf",
    "{cat:psf,file}",
    "--mag-zeropoint",
    "{extract:mag-zeropoint}",
    "--n-workers",
    "{extract:n-workers}",
    {
     "if_file": "{cat:psf,model}",
     "argv": [
      "--psf-model",
      "{cat:psf,model}"
     ]
    }
   ],
   "output": {
    "mode": "add_columns",
    "columns": [
     "FLUX_PSF",
     "FLUXERR_PSF",
     "MAG_PSF",
     "MAGERR_PSF",
     "CHI2_PSF",
     "X_PSF",
     "Y_PSF"
    ]
   }
  },
  {
   "id": "multiband",
   "label": "Multi-Band Photometry...",
   "proc": "CatalogPanelMultiBand",
   "legacy": [
    "Analysis > Multi-Band Photometry..."
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.multiband"
   ],
   "needs": [
    "catalog",
    "image"
   ]
  },
  {
   "id": "crowded",
   "label": "Crowded Field Photometry",
   "legacy": [
    "Analysis > Crowded Field Photometry"
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.crowded_phot"
   ],
   "needs": [
    "catalog",
    "image",
    "psf"
   ],
   "title": "Crowded field photometry",
   "record": "analysis.crowded_phot",
   "requires": "psf",
   "done_status": "Crowded field photometry complete",
   "cli": [
    "{python}",
    "{script:ds9_crowded_phot.py}",
    "{image}",
    "--catalog",
    "{catalog}",
    "--psf",
    "{cat:psf,file}",
    "--mag-zeropoint",
    "{extract:mag-zeropoint}",
    "--n-workers",
    "{extract:n-workers}",
    {
     "if_file": "{cat:psf,model}",
     "argv": [
      "--psf-model",
      "{cat:psf,model}"
     ]
    }
   ],
   "output": {
    "mode": "add_columns",
    "columns": [
     "FLUX_CROWD",
     "FLUXERR_CROWD",
     "MAG_CROWD",
     "X_CROWD",
     "Y_CROWD",
     "N_NEIGHBORS"
    ]
   }
  },
  {
   "id": "crossmatch",
   "label": "Cross-Match (VizieR)...",
   "proc": "CatalogPanelCrossMatch",
   "legacy": [
    "Analysis > Cross-Match (VizieR)..."
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.crossmatch"
   ],
   "needs": [
    "catalog"
   ],
   "network": 1
  },
  {
   "id": "segmap",
   "label": "Segmentation Map",
   "proc": "CatalogPanelSegmentationMap",
   "legacy": [
    "Analysis > Segmentation Map"
   ],
   "session": "AUTO",
   "records": [
    "analysis.segmap"
   ],
   "needs": [
    "image"
   ]
  },
  {
   "id": "completeness",
   "label": "Completeness Simulation...",
   "proc": "CatalogPanelCompleteness",
   "legacy": [
    "Analysis > Completeness Simulation..."
   ],
   "session": "AUTO",
   "records": [
    "analysis.completeness"
   ],
   "needs": [
    "image"
   ]
  }
 ],
 "short": "Photometry",
 "primary": "psf_phot",
 "tcl": "photometry.tcl",
 "tcl_always": 1
}
