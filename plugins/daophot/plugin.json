{
 "schema": 1,
 "id": "daophot",
 "name": "DAOPHOT crowded-field photometry",
 "short": "DAOPHOT",
 "tab": "Measure",
 "order": 27,
 "description": "DAOPHOT / ALLSTAR / DAOMASTER workflow: FIND (sharpness/roundness cuts), PHOT (apertures, sky annulus/modes), PICKPSF (auto + manual), PSF (analytic + lookup table, order 0-3, neighbour subtraction), ALLSTAR group fitting with iterative re-find, SUBSTAR/ADDSTAR, DAOMATCH/DAOMASTER cross-matching, aperture correction, quality flags, CMD output, artificial-star completeness tests.",
 "requires": {
  "python": [
   "numpy",
   "astropy",
   "photutils",
   "scipy",
   "sep"
  ]
 },
