{
  "schema": 1,
  "id": "moving",
  "name": "Moving objects and transients",
  "tab": "Time-domain",
  "order": 10,
  "description": "Multi-epoch asteroid / transient pipeline (reference fetch, alignment, ZOGY differencing, tracklets, orbit fit).",
  "network": 0,
  "steps": [
    {
      "id": "fetch",
      "label": "Fetch Reference...",
      "proc": "OGFMovFetchDialog",
      "legacy": [
        "Moving Objects > Fetch Reference..."
      ],
      "session": "AUTO",
      "records": [
        "moving.fetch"
      ]
    },
    {
      "id": "align",
      "label": "Align",
      "proc": "OGFMovAlign",
      "legacy": [
        "Moving Objects > Align"
      ],
      "session": "AUTO",
      "records": [
        "moving.align"
      ]
    },
    {
      "id": "difference",
      "label": "Difference",
      "proc": "OGFMovDifference",
      "legacy": [
        "Moving Objects > Difference"
      ],
      "session": "AUTO",
      "records": [
        "moving.difference"
      ]
    },
    {
      "id": "detect",
      "label": "Detect",
      "proc": "OGFMovDetect",
      "legacy": [
        "Moving Objects > Detect"
      ],
      "session": "NONE"
    },
    {
      "id": "link",
      "label": "Link Tracklets",
      "proc": "OGFMovLink",
      "legacy": [
        "Moving Objects > Link Tracklets"
      ],
      "session": "AUTO",
      "records": [
        "moving.link"
      ]
    },
    {
      "id": "identify",
      "label": "Identify Known Objects",
      "proc": "OGFMovIdentify",
      "legacy": [
        "Moving Objects > Identify Known Objects"
      ],
      "session": "AUTO",
      "records": [
        "moving.identify"
      ],
      "network": 1
    },
    {
      "id": "orbit",
      "label": "Orbit Fit...",
      "proc": "OGFMovOrbitDialog",
      "legacy": [
        "Moving Objects > Orbit Fit..."
      ],
      "session": "AUTO",
      "records": [
        "moving.orbit"
      ]
    },
    {
      "id": "transients",
      "label": "Transient Candidates...",
      "proc": "OGFMovTransients",
      "legacy": [
        "Moving Objects > Transient Candidates..."
      ],
      "session": "AUTO",
      "records": [
        "moving.transients"
      ]
    },
    {
      "id": "lightcurve",
      "label": "Light Curve",
      "proc": "OGFMovLightCurve",
      "legacy": [
        "Moving Objects > Light Curve"
      ],
      "session": "AUTO",
      "records": [
        "moving.lightcurve"
      ]
    },
    {
      "id": "export",
      "label": "Export...",
      "proc": "OGFMovExport",
      "legacy": [
        "Moving Objects > Export..."
      ],
      "session": "AUTO",
      "records": [
        "moving.export"
      ]
    },
    {
      "id": "select",
      "label": "Select Exposures...",
      "proc": "OGFMovSelectFiles",
      "legacy": [
        "Moving Objects > Select Exposures..."
      ],
      "session": "NONE"
    },
    {
      "id": "workdir",
      "label": "Work Directory...",
      "proc": "OGFMovWorkdir",
      "legacy": [
        "Moving Objects > Work Directory..."
      ],
      "session": "NONE"
    },
    {
      "id": "details",
      "label": "Time-domain details...",
      "proc": "OGFMovDetails",
      "legacy": [
        "Moving Objects > Show Results Table (replaced: table is the main table; orbit / light curve in one details window)"
      ],
      "session": "NONE"
    }
  ],
  "short": "Moving",
  "primary": "link",
  "tcl": "moving.tcl",
  "init": "OGFMovingInit",
  "settings": "params",
  "params": [
    {
      "name": "source-noise",
      "label": "Source-noise term",
      "type": "bool",
      "default": 0,
      "group": "Difference (ZOGY)",
      "help": "Include the Poisson variance of bright sources in the ZOGY score (fewer negative / static-star residuals; the known BB89 mover keeps all its detections). Off = classic sky-noise-only ZOGY."
    },
    {
      "name": "astrom",
      "label": "Registration error",
      "type": "choice",
      "default": "off",
      "choices": [
        "off",
        "measure",
        "sidecar"
      ],
      "group": "Difference (ZOGY)",
      "help": "Astrometric-registration term of ZOGY. measure = estimated from the star offsets of every exposure/template pair; sidecar = rms of the alignment fit; off = none (default). Can remove real movers near stars - see docs/moving_objects.md."
    },
    {
      "name": "psf-tile",
      "label": "PSF tile size",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2048,
      "unit": "pix",
      "group": "Difference (ZOGY)",
      "expert": 1,
      "help": "0 = one PSF per chip. N > 0 = PSF measured per N x N tile and tiled ZOGY (needs several stars per tile; sparse fields fall back to the pooled PSF)."
    },
    {
      "name": "psf-source",
      "label": "PSF source",
      "type": "choice",
      "default": "tiles",
      "choices": [
        "tiles",
        "model"
      ],
      "group": "Difference (ZOGY)",
      "expert": 1,
      "help": "With a PSF tile size > 0: tiles = PSF stacked from the stars of every tile (default); model = one spatially varying polynomial PSF model per chip (PSFEx-like, falls back to the default PSF with few stars or a too narrow model)."
    },
    {
      "name": "template-psf",
      "label": "Template PSF",
      "type": "choice",
      "default": "target",
      "choices": [
        "target",
        "measure"
      ],
      "group": "Difference (ZOGY)",
      "expert": 1,
      "help": "target = use the target PSF for the template (default); measure = measure the template PSF from the template's own stars."
    }
  ]
}
