{
 "schema": 1,
 "id": "ds10core",
 "name": "Astrafex Core (regions, pixel table, calibration, forced photometry, scripts)",
 "short": "Astrafex Core",
 "tab": "Measure",
 "order": 70,
 "dialog_tabs": 1,
 "description": "Stand-alone shell of the compute core that the Astrafex Web server also uses (one core, two shells): DS9/JSON/CSV regions with exact pixel statistics and masks, pixel table, weight/rms/exposure/mask map association, header-driven AB zero points, multi-band forced photometry (detection image, forced aperture/Kron/isophotal, correlated-noise errors, upper limits, colours; optional PSF matching) and a runner for astrafex-script/1 step lists, replay scripts and bundles exported from the web app. Runs headless; the core lives in the Astrafex Web repository and is started as a separate process. Includes the shared-core LSBG finder (ds10core.tools.lsbg); sky catalogue query / cross-match, MAST search and download, and user Python plugins; star aperture photometry with clicked stars and light curves (ds10core.tools.aper_phot).",
 "license": {
  "plugin": "original glue code: argument vectors only, imports no ds9, AST or SEP code",
  "core": "ds10core (Astrafex Web repository): original code, numpy + scipy (BSD-3) only; proprietary, owner decides; NOT GPL",
  "boundary": "separate process (python -m astrafex_core)",
  "ds9_code_in_core": false,
  "web": false
 },
 "web": false,
 "requires": {
  "python": [
   "numpy",
   "scipy"
  ]
 },
 "primary": "calib",
 "settings": "params",
 "steps": [
