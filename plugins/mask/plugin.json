   "proc": "CatalogPanelMaskToggleOverlay",
   "legacy": [
    "Mask > Show Mask Overlay"
   ],
   "session": "NONE",
   "toggle": "ogfmask(overlay)"
  },
  {
   "id": "overlay_style",
   "label": "Overlay Colour/Transparency...",
   "proc": "CatalogPanelMaskOverlaySettings",
   "legacy": [
    "Mask > Overlay Colour/Transparency..."
   ],
   "session": "NONE"
  },
  {
