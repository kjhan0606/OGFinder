   "label": "Save Mask As...",
   "proc": "CatalogPanelMaskSaveAs",
   "legacy": [
    "Mask > Save As..."
   ],
   "session": "AUTO",
   "records": [
    "mask.export"
   ]
  },
  {
   "id": "import",
