{
 "schema": 1,
 "id": "mask",
 "name": "Mask",
 "tab": "Low-SB",
 "order": 10,
 "description": "One shared bit-flag mask per image: automatic masking, region editing, overlay, import/export.",
 "steps": [
  {
   "id": "auto",
   "label": "Auto Mask...",
   "proc": "CatalogPanelMaskAuto",
   "legacy": [
    "Mask > Auto Mask..."
   ],
   "session": "AUTO",
   "records": [
    "mask.auto"
   ],
   "needs": [
    "image"
   ],
   "headless": {
    "title": "Auto Mask",
    "record": "mask.auto",
    "requires": "",
    "needs": [
     "image"
    ],
    "session": "AUTO",
    "catalog_tmp": "mask",
    "before": "OGFMaskHeadlessBefore",
    "after": "OGFMaskHeadlessAfter",
    "cli": [
     "{python}",
     "{script:ds9_mask.py}",
     "{image}",
     "--mode",
     "auto",
     "--mask",
     "{work}/mask_{base}.fits",
     "--detect-thresh",
     "{auto-detect-thresh}",
     "--minarea",
     "{auto-minarea}",
     "--expand-factor",
     "{auto-expand-factor}",
     "--max-dilate-radius",
     "{auto-max-dilate-radius}",
     "--bright-star-mag-limit",
     "{auto-bright-star-mag-limit}",
     "--bright-star-radius-scale",
     "{auto-bright-star-radius-scale}",
     "--mag-threshold",
     "{auto-mag-threshold}",
     "--mag-zeropoint",
     "{extract:mag-zeropoint}",
     "--n-workers",
     "{extract:n-workers}",
     "--pixel-scale",
     "{lsbg:pixel-scale}",
     "--lsb-mu-threshold",
     "{lsbg:lsb-mu-threshold}",
     {
      "if": "auto-lsb-protect",
      "argv": [
       "--lsb-protect"
      ]
     },
     {
      "if_file": "{catalog}",
      "argv": [
       "--catalog",
       "{catalog}"
      ]
     }
    ],
    "output": {
     "mode": "capture"
    }
   }
  },
  {
   "id": "overlay",
   "label": "Show Mask Overlay",
   "proc": "CatalogPanelMaskToggleOverlay",
   "legacy": [
    "Mask > Show Mask Overlay"
   ],
   "session": "NONE",
   "toggle": "ogfmask(overlay)"
  },
  {
   "id": "overlay_style",
   "label": "Overlay Colour/Transparency...",
   "proc": "OGFParamDialog mask",
   "legacy": [
    "Mask > Overlay Colour/Transparency..."
   ],
   "session": "NONE",
   "settings_only": 1
  },
  {
   "id": "edit",
   "label": "Edit Mask",
   "session": "MANUAL",
   "records": [
    "mask.add",
    "mask.erase",
    "mask.grow",
    "mask.shrink",
    "mask.invert",
    "mask.clear",
    "mask.undo",
    "mask.redo"
   ],
   "needs": [
    "image"
   ],
   "variants": [
    {
     "id": "add",
     "label": "Add Regions to Mask",
     "proc": "CatalogPanelMaskRegions 0",
     "legacy": [
      "Mask > Add Regions to Mask"
     ]
    },
    {
     "id": "erase",
     "label": "Erase Regions from Mask",
     "proc": "CatalogPanelMaskRegions 1",
     "legacy": [
      "Mask > Erase Regions from Mask"
     ]
    },
    {
     "id": "grow",
     "label": "Grow...",
     "proc": "CatalogPanelMaskGrow 0",
     "legacy": [
      "Mask > Grow..."
     ]
    },
    {
     "id": "shrink",
     "label": "Shrink...",
     "proc": "CatalogPanelMaskGrow 1",
     "legacy": [
      "Mask > Shrink..."
     ]
    },
    {
     "id": "invert",
     "label": "Invert",
     "proc": "CatalogPanelMaskSimple invert",
     "legacy": [
      "Mask > Invert"
     ]
    },
    {
     "id": "clear",
     "label": "Clear Mask",
     "proc": "CatalogPanelMaskSimple clear",
     "legacy": [
      "Mask > Clear Mask"
     ]
    },
    {
     "id": "undo",
     "label": "Undo",
     "proc": "CatalogPanelMaskSimple undo",
     "legacy": [
      "Mask > Undo"
     ]
    },
    {
     "id": "redo",
     "label": "Redo",
     "proc": "CatalogPanelMaskSimple redo",
     "legacy": [
      "Mask > Redo"
     ]
    }
   ]
  },
  {
   "id": "save_as",
   "label": "Save Mask As...",
   "proc": "CatalogPanelMaskSaveAs",
   "legacy": [
    "Mask > Save As..."
   ],
   "session": "AUTO",
   "records": [
    "mask.export"
   ]
  },
  {
   "id": "import",
   "label": "Import Mask...",
   "proc": "CatalogPanelMaskImport",
   "legacy": [
    "Mask > Import..."
   ],
   "session": "MANUAL",
   "records": [
    "mask.import"
   ]
  },
  {
   "id": "masked",
   "label": "Show Masked Image",
   "proc": "CatalogPanelMaskShowMasked",
   "legacy": [
    "Mask > Show Masked Image"
   ],
   "session": "AUTO",
   "records": [
    "mask.masked"
   ]
  },
  {
   "id": "stats",
   "label": "Mask Statistics",
   "proc": "CatalogPanelMaskStats",
   "legacy": [
    "Mask > Statistics"
   ],
   "session": "NONE"
  }
 ],
 "short": "Mask",
 "primary": "auto",
 "settings": "params",
 "tcl": "mask.tcl",
 "required": 1,
 "params": [
  {
   "name": "color",
   "label": "Colour",
   "type": "string",
   "default": "red",
   "group": "Overlay",
   "help": "Colour name or #rrggbb of the mask overlay."
  },
  {
   "name": "transparency",
   "label": "Transparency",
   "type": "int",
   "default": 50,
   "group": "Overlay",
   "help": "Overlay transparency in percent (0 = opaque, 100 = invisible).",
   "min": 0,
   "max": 100,
   "unit": "%"
  },
  {
   "name": "auto-detect-thresh",
   "label": "Detection threshold",
   "type": "float",
   "default": 5.0,
   "group": "Auto mask (shared)",
   "help": "Auto Mask detection threshold (sigma).",
   "key": "p,detect-thresh",
   "min": 0.1,
   "max": 100
  },
  {
   "name": "auto-minarea",
   "label": "Min area",
   "type": "int",
   "default": 5,
   "group": "Auto mask (shared)",
   "help": "Minimum connected pixels.",
   "key": "p,minarea",
   "min": 1,
   "max": 100000
  },
  {
   "name": "auto-expand-factor",
   "label": "Expansion factor",
   "type": "float",
   "default": 1.5,
   "group": "Auto mask (shared)",
   "help": "Source ellipse expansion factor.",
   "key": "p,expand-factor"
  },
  {
   "name": "auto-max-dilate-radius",
   "label": "Max dilate radius",
   "type": "int",
   "default": 20,
   "group": "Auto mask (shared)",
   "help": "Maximum dilation radius in pixels.",
   "key": "p,max-dilate-radius"
  },
  {
   "name": "auto-bright-star-mag-limit",
   "label": "Bright-star mag limit",
   "type": "float",
   "default": 18.0,
   "group": "Auto mask (shared)",
   "help": "Stars brighter than this get a larger mask.",
   "key": "p,bright-star-mag-limit"
  },
  {
   "name": "auto-bright-star-radius-scale",
   "label": "Bright-star radius scale",
   "type": "float",
   "default": 10.0,
   "group": "Auto mask (shared)",
   "help": "Bright-star mask radius scale.",
   "key": "p,bright-star-radius-scale"
  },
  {
   "name": "auto-mag-threshold",
   "label": "Mask only brighter than mag",
   "type": "float",
   "default": 99.0,
   "group": "Auto mask (shared)",
   "help": "99 = mask everything detected.",
   "key": "p,mag-threshold"
  },
  {
   "name": "auto-lsb-protect",
   "label": "Protect LSB structures",
   "type": "bool",
   "default": false,
   "group": "Auto mask (shared)",
   "help": "Do not mask low-surface-brightness structures.",
   "key": "p,lsb-protect"
  }
 ],
 "store": {
  "array": "ogfmask",
  "key": "%s"
 },
 "on_apply": "OGFMaskOverlayApplied"
}
