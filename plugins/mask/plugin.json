    },
    {
     "id": "grow",
     "label": "Grow...",
     "proc": "CatalogPanelMaskGrow 0",
     "legacy": [
      "Mask > Grow..."
     ]
    },
    {
     "id": "shrink",
     "label": "Shrink...",
     "proc": "CatalogPanelMaskGrow 1",
     "legacy": [
      "Mask > Shrink..."
     ]
    },
    {
     "id": "invert",
     "label": "Invert",
     "proc": "CatalogPanelMaskSimple invert",
     "legacy": [
      "Mask > Invert"
     ]
    },
    {
     "id": "clear",
     "label": "Clear Mask",
     "proc": "CatalogPanelMaskSimple clear",
     "legacy": [
      "Mask > Clear Mask"
     ]
    },
    {
     "id": "undo",
     "label": "Undo",
     "proc": "CatalogPanelMaskSimple undo",
     "legacy": [
      "Mask > Undo"
     ]
    },
    {
     "id": "redo",
     "label": "Redo",
     "proc": "CatalogPanelMaskSimple redo",
     "legacy": [
      "Mask > Redo"
     ]
    }
   ]
  },
  {
