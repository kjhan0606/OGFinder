   ],
   "session": "NONE"
  },
  {
   "id": "psf_settings",
   "label": "PSF / Star Settings...",
   "proc": "CatalogPanelStarPSFSettings",
   "legacy": [
    "Star(PSF) > Settings..."
   ],
   "session": "NONE",
   "settings_only": 1
  }
 ],
 "short": "Stars/PSF",
 "primary": "ai_star",
 "settings": "CatalogPanelStarPSFSettings",
 "tcl": "star_psf.tcl",
 "tcl_always": 1
}
