{
 "schema": 1,
 "id": "morphology",
 "name": "Structure",
 "tab": "Measure",
 "order": 10,
 "description": "Sersic fitting, non-parametric morphology, bulge+disk decomposition.",
 "store": {
  "array": "catpanel",
  "key": "bd,param,%s",
  "save": "CatalogPanelBDParamSave"
 },
 "steps": [
  {
   "id": "sersic",
   "label": "Sersic Fitting",
   "proc": "CatalogPanelSersicFit",
   "legacy": [
    "Analysis > Sérsic Fitting"
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.sersic"
   ],
   "needs": [
    "catalog",
    "image"
   ]
  },
  {
   "id": "morphometry",
   "label": "Non-Parametric Morphology (CAS/Gini/M20)",
   "proc": "CatalogPanelMorphometry",
   "legacy": [
    "Analysis > Non-Parametric Morphology (CAS/Gini/M20)"
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.morphometry"
   ],
   "needs": [
    "catalog",
    "image"
   ]
  },
  {
   "id": "bulge_disk",
   "label": "Bulge+Disk Decomposition",
   "proc": "CatalogPanelBulgeDisk",
   "legacy": [
    "Analysis > Bulge+Disk Decomp..."
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.bulge_disk"
   ],
   "needs": [
    "catalog",
    "image"
   ],
   "settings": "params"
  }
 ],
 "params": [
  {
   "name": "max-sources",
   "label": "Max sources",
   "type": "int",
   "default": 100,
   "group": "Bulge+Disk",
   "help": "Fit at most this many sources (brightest first).",
   "min": 1,
   "max": 100000
  },
  {
   "name": "free-bulge-n",
   "label": "Free bulge Sersic n",
   "type": "bool",
   "default": 0,
   "group": "Bulge+Disk",
   "help": "Let the bulge Sersic index vary instead of fixing n=4."
  },
  {
   "name": "mag-zeropoint",
   "label": "Mag zeropoint",
   "type": "float",
   "default": 25.0,
   "group": "Bulge+Disk",
   "help": "Magnitude zeropoint of the image."
  },
  {
   "name": "pixel-scale",
   "label": "Pixel scale",
   "type": "float",
   "default": 0.263,
   "group": "Bulge+Disk",
   "help": "Pixel scale in arcsec/pixel.",
   "min": 0.0001,
   "max": 100,
   "unit": "arcsec/pix"
  }
 ],
 "short": "Structure",
 "primary": "sersic",
 "settings": "params",
 "tcl": [
  "bulge_disk.tcl",
  "morphology.tcl"
 ],
 "tcl_always": 1
}
