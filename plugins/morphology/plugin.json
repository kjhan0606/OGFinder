{
 "schema": 1,
 "id": "morphology",
 "name": "Structure",
 "tab": "Measure",
 "order": 10,
 "description": "Sersic fitting, non-parametric morphology, bulge+disk decomposition.",
 "store": {
  "array": "catpanel",
  "key": "bd,param,%s",
  "save": "CatalogPanelBDParamSave"
 },
 "steps": [
  {
   "id": "sersic",
   "label": "Sersic Fitting",
   "legacy": [
    "Analysis > Sérsic Fitting"
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.sersic"
   ],
   "needs": [
    "catalog",
    "image"
   ],
   "title": "Sersic fitting",
   "record": "analysis.sersic",
   "requires": "",
   "done_status": "Sérsic fitting complete",
   "cli": [
    "{python}",
    "{script:ds9_sersic.py}",
    "{image}",
    "--catalog",
    "{catalog}",
    "--mag-zeropoint",
    "{extract:mag-zeropoint}",
    "--n-workers",
    "{extract:n-workers}"
   ],
   "output": {
    "mode": "add_columns",
    "columns": [
     "SERSIC_N",
     "SERSIC_RE",
     "SERSIC_IE",
     "SERSIC_ELLIP",
     "SERSIC_THETA",
     "SERSIC_CHI2"
    ]
   }
  },
  {
   "id": "morphometry",
   "label": "Non-Parametric Morphology (CAS/Gini/M20)",
   "legacy": [
    "Analysis > Non-Parametric Morphology (CAS/Gini/M20)"
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.morphometry"
   ],
   "needs": [
    "catalog",
    "image"
   ],
   "title": "Non-parametric morphology (CAS/Gini/M20)",
   "record": "analysis.morphometry",
   "requires": "",
   "done_status": "Morphometry complete (CAS/Gini/M20/Petrosian)",
   "cli": [
    "{python}",
    "{script:ds9_morphometry.py}",
    "{image}",
    "--catalog",
    "{catalog}",
    "--n-workers",
    "{extract:n-workers}"
   ],
   "output": {
    "mode": "add_columns",
    "columns": [
     "CONC",
     "ASYM",
     "GINI",
     "M20",
     "R_PETRO"
    ]
   }
  },
  {
   "id": "bulge_disk",
   "label": "Bulge+Disk Decomposition",
   "legacy": [
    "Analysis > Bulge+Disk Decomp..."
   ],
   "session": "AUTO",
   "stage": "measure",
   "records": [
    "analysis.bulge_disk"
   ],
   "needs": [
    "catalog",
    "image"
   ],
   "settings": "params",
   "title": "Bulge+Disk decomposition",
   "record": "analysis.bulge_disk",
   "requires": "",
   "done_status": "Bulge+Disk decomposition complete",
   "catalog_tmp": "bulgedisk",
   "cli": [
    "{python}",
    "{script:ds9_bulge_disk.py}",
    "{image}",
    "--catalog",
    "{catalog}",
    "--mag-zeropoint",
    "{mag-zeropoint}",
    "--pixel-scale",
    "{pixel-scale}",
    "--max-sources",
    "{max-sources}",
    {
     "if": "free-bulge-n",
     "argv": [
      "--free-bulge-n"
     ]
    },
    {
     "if_file": "{cat:psf,file}",
     "argv": [
      "--psf",
      "{cat:psf,file}"
     ]
    },
    "--n-workers",
    "{extract:n-workers}"
   ],
   "output": {
    "mode": "add_columns",
    "columns": [
     "BT_RATIO",
     "BULGE_RE",
     "BULGE_MAG",
     "DISK_RS",
     "DISK_MAG",
     "BD_CHI2",
     "BD_FLAG"
    ]
   }
  }
 ],
 "params": [
  {
   "name": "max-sources",
   "label": "Max sources",
   "type": "int",
   "default": 100,
   "group": "Bulge+Disk",
   "help": "Fit at most this many sources (brightest first).",
   "min": 1,
   "max": 100000
  },
  {
   "name": "free-bulge-n",
   "label": "Free bulge Sersic n",
   "type": "bool",
   "default": 0,
   "group": "Bulge+Disk",
   "help": "Let the bulge Sersic index vary instead of fixing n=4."
  },
  {
   "name": "mag-zeropoint",
   "label": "Mag zeropoint",
   "type": "float",
   "default": 25.0,
   "group": "Bulge+Disk",
   "help": "Magnitude zeropoint of the image."
  },
  {
   "name": "pixel-scale",
   "label": "Pixel scale",
   "type": "float",
   "default": 0.263,
   "group": "Bulge+Disk",
   "help": "Pixel scale in arcsec/pixel.",
   "min": 0.0001,
   "max": 100,
   "unit": "arcsec/pix"
  }
 ],
 "short": "Structure",
 "primary": "sersic",
 "settings": "params",
 "tcl": [
  "bulge_disk.tcl",
  "morphology.tcl"
 ],
 "tcl_always": 1
}
